{
    "name": "abigah/bot-cop-traffic-client",
    "description": "The site-side toolkit for Bot Cop Traffic Division: job heartbeats, deploy pings and exception reporting. No UI dependencies; installable on any Laravel or Statamic site.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "monitoring",
        "heartbeat",
        "uptime",
        "bot-cop"
    ],
    "authors": [
        {
            "name": "Sheldon Kotyk",
            "email": "sheldon@kotyk.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "opis/json-schema": "^2.3",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Abigah\\BotCopTrafficClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abigah\\BotCopTrafficClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abigah\\BotCopTrafficClient\\MonitoringClientServiceProvider"
            ],
            "aliases": {
                "MonitoringClient": "Abigah\\BotCopTrafficClient\\Facades\\MonitoringClient"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "contracts:init": "git submodule update --init tests/contracts",
        "contracts:update": "git submodule update --remote tests/contracts",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
